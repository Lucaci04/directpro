---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { contact, services, type Service } from '../../data/site';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props as { service: Service };
const index = services.indexOf(service);
const next = services[(index + 1) % services.length];
---
<Base title={service.name} description={`${service.short} DIRECTPRO, atelier autorizat R.A.R. în București. Sună la ${contact.phoneDisplay}.`}>
  <section class="svc-hero" aria-labelledby="svc-title">
    <span class="stop is-lit svc-stop" data-stop aria-hidden="true"></span>
    <div class="wrap svc-hero-inner">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Acasă</a>
        <span aria-hidden="true">/</span>
        <a href="/servicii">Servicii</a>
      </nav>
      <div class="svc-title-row">
        <span class="svc-bay sign" aria-label={`Boxa ${service.bay}`}>{service.bay}</span>
        <h1 id="svc-title">{service.name}</h1>
      </div>
      <div class="svc-intro">
        {service.intro.map((p, i) => <p class:list={{ lede: i === 0 }}>{p}</p>)}
      </div>
    </div>
    <div class="svc-photo-wrap wrap">
      <Image class="svc-photo" src={service.photo} alt={service.photoAlt} widths={[640, 1024]} sizes="(max-width: 1240px) 100vw, 1100px" loading="eager" />
    </div>
  </section>

  <section class="section svc-body" aria-label="Detalii serviciu">
    <span class="stop" data-stop aria-hidden="true"></span>
    <div class="wrap svc-grid">
      <div class="svc-groups">
        {service.groups.map((g) => (
          <div class="group paint-in">
            <h2>{g.title}</h2>
            {g.text && <p>{g.text}</p>}
            {g.items && (
              <ul class="ticks">
                {g.items.map((item) => <li><Icon name="check" size={18} />{item}</li>)}
              </ul>
            )}
          </div>
        ))}
        {service.audience && <p class="audience">{service.audience}</p>}
      </div>

      <aside class="svc-aside" aria-label="Programare">
        <div class="ticket bay-frame">
          <p class="sign ticket-sign">Programare</p>
          <p>Descrie-ne mașina și problema. Îți spunem ce urmează.</p>
          <a class="btn btn--call ticket-call" href={contact.phoneHref}><Icon name="phone" />{contact.phoneDisplay}</a>
          <a class="btn btn--ghost" href={contact.whatsappHref} rel="noopener" target="_blank"><Icon name="chat" />Scrie pe WhatsApp</a>
          <p class="ticket-meta"><Icon name="clock" size={16} />{contact.hours}</p>
        </div>
      </aside>
    </div>
  </section>

  {service.steps && (
    <section class="section svc-steps" aria-labelledby="steps-title">
      <span class="stop" data-stop aria-hidden="true"></span>
      <div class="wrap">
        <h2 id="steps-title">{service.steps.title}</h2>
        <ol class="steps">
          {service.steps.items.map((step, i) => (
            <li class="paint-in" style={`--i:${i}`}>
              <span class="step-n sign" aria-hidden="true">{i + 1}</span>
              <span>{step}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <section class="section svc-next" aria-label="Următoarea boxă">
    <div class="wrap next-row">
      <a class="next-link" href={`/servicii/${next.slug}`}>
        <span class="visually-hidden">Serviciul următor: </span>
        <span class="next-name"><span class="sign next-bay">{next.bay}</span>{next.name}<Icon name="arrow" size={28} /></span>
      </a>
      <a class="all-link" href="/servicii">Toate serviciile</a>
    </div>
  </section>
</Base>

<style>
  .svc-hero {
    position: relative;
    padding-top: clamp(1.5rem, 4vw, 3.5rem);
  }

  .svc-stop {
    top: clamp(5.6rem, 9vw, 8rem);
  }

  .crumbs {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-soft);
  }

  .crumbs a {
    color: var(--ink-soft);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .svc-title-row {
    display: flex;
    gap: clamp(0.8rem, 2vw, 1.5rem);
    align-items: flex-start;
    margin-top: 0.5rem;
  }

  .svc-bay {
    flex: none;
    padding: 0.4rem 0.6rem;
    background: var(--lane);
    font-size: clamp(1.4rem, 1rem + 2vw, 2.6rem);
  }

  h1 {
    font-size: var(--step-5);
    font-stretch: 118%;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 0.98;
    max-width: 14ch;
  }

  .svc-intro {
    display: grid;
    gap: 1rem;
    max-width: 62ch;
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 clamp(2rem, 4vw, 3rem);
  }

  .svc-intro p:not(.lede) {
    color: var(--ink-soft);
  }

  .svc-photo-wrap :global(.svc-photo) {
    width: 100%;
    aspect-ratio: 21 / 9;
    object-fit: cover;
    border-radius: var(--radius);
  }

  @media (prefers-reduced-motion: no-preference) {
    .svc-photo-wrap :global(.svc-photo) {
      animation: open 1200ms var(--ease-out) both;
    }
  }

  @keyframes open {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  .svc-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 3rem clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .svc-groups {
    display: grid;
    gap: clamp(2rem, 3.5vw, 2.75rem);
  }

  .group h2 {
    font-size: var(--step-2);
    margin-bottom: 0.7rem;
  }

  .group p {
    max-width: 60ch;
    color: var(--ink-soft);
  }

  .ticks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .ticks li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
  }

  .ticks :global(svg) {
    flex: none;
    margin-top: 0.3em;
    color: var(--teal-ink);
  }

  .audience {
    padding: 1rem 1.25rem;
    background: var(--paper);
    border-top: 4px solid var(--lane);
    font-weight: 600;
  }

  .svc-aside {
    position: sticky;
    top: 6rem;
  }

  .ticket {
    --c: var(--ink);
    display: grid;
    gap: 0.9rem;
    padding: 1.75rem;
    background-color: var(--paper);
  }

  .ticket-sign {
    font-size: var(--step-1);
  }

  .ticket .btn {
    width: 100%;
  }

  .ticket-call {
    font-size: var(--step-1);
  }

  .ticket-meta {
    display: flex;
    gap: 0.45rem;
    align-items: center;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-soft);
  }

  .svc-steps {
    background: var(--paper);
  }

  .svc-steps h2 {
    font-size: var(--step-3);
    margin-bottom: 2rem;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr));
    gap: 0;
    counter-reset: step;
  }

  .steps li {
    display: grid;
    gap: 0.8rem;
    align-content: start;
    padding: 1.25rem 1rem 1.5rem 0;
    border-top: var(--lane-w) solid var(--lane);
    font-weight: 600;
    line-height: 1.4;
  }

  .step-n {
    font-size: var(--step-3);
    color: var(--ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .steps li.paint-in {
      transition-delay: calc(var(--i) * 90ms);
    }
  }

  .next-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem;
  }

  .next-link {
    display: grid;
    gap: 0.6rem;
    color: var(--ink);
    text-decoration: none;
  }

  .next-name {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: var(--step-3);
    font-stretch: 115%;
    font-weight: 780;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .next-bay {
    padding: 0.3rem 0.45rem;
    background: var(--floor-deep);
    font-size: 1rem;
    transition: background-color 200ms var(--ease-out);
  }

  .next-link:hover .next-bay {
    background: var(--lane);
  }

  .next-link :global(svg) {
    flex: none;
    transition: transform 240ms var(--ease-out);
  }

  .next-link:hover :global(svg) {
    transform: translateX(6px);
  }

  .all-link {
    font-weight: 650;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  @media (max-width: 860px) {
    .svc-grid {
      grid-template-columns: 1fr;
    }

    .svc-aside {
      position: static;
    }

    .svc-photo-wrap :global(.svc-photo) {
      aspect-ratio: 16 / 10;
    }
  }
</style>
