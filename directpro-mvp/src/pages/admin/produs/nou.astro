---
import Admin from '../../../layouts/Admin.astro';
import ProductForm from '../../../components/ProductForm.astro';
import { emptyValues, readProductForm, type FormErrors } from '../../../lib/product-form';
import { addProduct } from '../../../lib/products';

export const prerender = false;

let values = emptyValues;
let errors: FormErrors = {};

if (Astro.request.method === 'POST') {
  const result = await readProductForm(await Astro.request.formData(), true);
  values = result.values;
  errors = result.errors;
  if (result.product) {
    const { image, ...rest } = result.product;
    const id = await addProduct({ ...rest, image: image! });
    return Astro.redirect(`/admin?mesaj=adaugat&id=${encodeURIComponent(id)}`, 303);
  }
}
---
<Admin title="Produs nou">
  <a class="back" href="/admin">← Înapoi la produse</a>
  <h1>Produs nou</h1>
  <ProductForm values={values} errors={errors} submitLabel="Adaugă produsul" />
</Admin>

<style>
  .back {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    font-weight: 600;
  }

  h1 {
    font-size: var(--step-3);
    margin: 0.5rem 0 1.5rem;
  }
</style>
