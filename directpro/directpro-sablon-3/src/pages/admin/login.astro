---
import Admin from '../../layouts/Admin.astro';
import {
  authConfigured,
  checkPassword,
  clearFailedLogins,
  isAuthenticated,
  loginBlocked,
  recordFailedLogin,
  startSession,
} from '../../lib/auth';

export const prerender = false;

if (isAuthenticated(Astro.cookies)) return Astro.redirect('/admin', 303);

let error = '';
const configured = authConfigured();
let ip = 'unknown';
try {
  ip = Astro.clientAddress;
} catch {}

if (Astro.request.method === 'POST' && configured) {
  if (loginBlocked(ip)) {
    error = 'Prea multe încercări greșite. Încearcă din nou peste 15 minute.';
  } else {
    const data = await Astro.request.formData();
    const password = String(data.get('parola') ?? '');
    if (checkPassword(password)) {
      clearFailedLogins(ip);
      startSession(Astro.cookies, Astro.url.protocol === 'https:');
      return Astro.redirect('/admin', 303);
    }
    recordFailedLogin(ip);
    error = 'Parola nu e corectă.';
  }
}
---
<Admin title="Autentificare" signedIn={false}>
  <div class="login">
    <h1>Autentificare</h1>
    {!configured ? (
      <p class="notice notice--error">
        Panoul de administrare e dezactivat: lipsesc variabilele <code>ADMIN_PASSWORD</code> și
        <code>ADMIN_SECRET</code> (minimum 32 de caractere) din fișierul <code>.env</code>.
      </p>
    ) : (
      <form method="post" class="login-form">
        {error && <p class="notice notice--error" role="alert">{error}</p>}
        <div class="field">
          <label for="parola">Parola de administrator</label>
          <input id="parola" name="parola" type="password" autocomplete="current-password" required autofocus aria-invalid={error ? 'true' : undefined} />
        </div>
        <button class="btn" type="submit">Intră în cont</button>
      </form>
    )}
  </div>
</Admin>

<style>
  .login {
    max-width: 420px;
    margin: clamp(1rem, 8vh, 5rem) auto 0;
    display: grid;
    gap: 1.5rem;
  }

  h1 {
    font-size: var(--step-3);
  }

  .login-form {
    display: grid;
    gap: 1.1rem;
    padding: 1.75rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-top: var(--lane-w) solid var(--lane);
  }
</style>
